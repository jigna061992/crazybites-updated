APP_NAME=CrazyBites
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# React frontend url (name as in config/app.php  frontend_url)
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: sqlite (default). first create file 
#   Windows: type nul > database\database.sqlite      Linux/Mac: touch database/database.sqlite
DB_CONNECTION=sqlite

#If use Mysql then DB_CONNECTION=mysql and uncomment below lines
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=crazybites
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ================= Blockchain (BSC testnet) =================
# false = From wallet-balance - slot activate (without MetaMask ). true = on-chain USDT payment.
# VITE_CHAIN_ENABLED also same (true/false) in Frontend.
CHAIN_ENABLED=false
CHAIN_RPC_URL=
# deploy-main.js output ma "CrazyBitsMain (MAIN)" address
CHAIN_VAULT_ADDRESS=
# USDT / MockUSDT address
CHAIN_USDT_ADDRESS=
# Treasury (DEPLOYER_KEY wallet) address
CHAIN_COMPANY_WALLET_ADDRESS=
# deploy-main.js output - "Deploy block"
CHAIN_START_BLOCK=0
CHAIN_CONFIRMATIONS=5
CHAIN_CHUNK=500
CHAIN_MAX_CHUNKS=5
